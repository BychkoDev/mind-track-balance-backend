{
  "manifest_version": 3,
  "name": "Mind-Track Balance",
  "version": "1.0.0",
  "description": "Monitors digital habits and manages mental health overlays.",
  "permissions": [
    "tabs",
    "storage",
    "idle",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  }
}
