generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model MediaImage {
  uuid             String   @id @default(uuid())
  imageName        String   @map("image_name") @db.VarChar(80)
  previewImageName String?  @map("preview_image_name") @db.VarChar(80)
  bucket           String   @db.VarChar(80)
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("images")
}
