generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  en
  uk
}

enum MotionVariant {
  soft
  float
  slideInLeft
  slideInRight
  zoomIn
  none
}

enum Orientation {
  horizontal
  vertical
}

enum PageSection {
  hero
  features
  stats
  testimonials
  footer
}

enum PageType {
  simple
  multiplex
}

enum Position {
  main
  badgeTop
  badgeBottom
}

enum SlotArea {
  left
  right
  center
  grid
  columns
}

enum UiColorToken {
  default
  purple
  blue
  teal
  green
  yellow
  orange
  pink
  red
  slate
}

enum IconKey {
  messageCircle
  trendingUp
  instagram
  linkedin
  sparkles
  twitter
  shied
  smile
  heart
  users
  quote
  pause
  brain
  clock
  mail
  moon
  sun
}

model Page {
  uuid                 String      @id @default(uuid())
  name                 String?     @unique
  url                  String      @unique
  inMenu               Boolean     @default(false)
  inHeaderMenu         Boolean     @default(false)
  createdAt            DateTime    @default(now()) @db.Timestamptz
  updatedAt            DateTime    @updatedAt @db.Timestamptz
  seoObjectTranslation SeoObject[]
  blocks               PageBlock[]

  @@index([inMenu], map: "idx_pages_in_menu")
  @@index([inHeaderMenu], map: "idx_pages_in_header_menu")
  @@map("pages")
}

enum ImageFormat {
  jpeg
  png
  webp
  svg
}

enum ImageVariantKind {
  original
  thumb
  web
  userAvatar
}

model PageBlock {
  uuid          String        @id @default(uuid())
  sortOrder     Int           @default(0)
  parentId      String?       @map("parent_id")
  parent        PageBlock?    @relation("BlockChildren", fields: [parentId], references: [uuid], onDelete: Cascade)
  children      PageBlock[]   @relation("BlockChildren")
  pageUuid      String        @map("page_id") // Was mistakenly set as page_id in TypeORM but referencing UUID
  page          Page          @relation(fields: [pageUuid], references: [uuid], onDelete: Cascade)
  orientation   Orientation   @default(horizontal)
  motionVariant MotionVariant @default(none)
  color         UiColorToken  @default(default)
  section       PageSection?
  area          SlotArea?
  createdAt     DateTime      @default(now()) @db.Timestamptz
  updatedAt     DateTime      @updatedAt @db.Timestamptz

  images       Image[]
  iconImage    IconImage?
  translations PageBlockTranslation[]

  @@index([sortOrder])
  @@index([parentId])
  @@index([pageUuid])
  @@index([pageUuid, section, area, sortOrder], map: "idx_page_section_area_sort")
  @@map("page_blocks")
}

model Image {
  uuid      String         @id @default(uuid())
  blockUuid String         @map("block_uuid")
  block     PageBlock      @relation(fields: [blockUuid], references: [uuid], onDelete: Cascade)
  variants  ImageVariant[]
  createdAt DateTime       @default(now()) @map("created_at")

  @@map("images")
}

model ImageVariant {
  uuid      String           @id @default(uuid())
  imageUuid String           @map("image_uuid")
  image     Image            @relation(fields: [imageUuid], references: [uuid], onDelete: Cascade)
  bucket    String           @db.VarChar(128)
  imageName String           @map("image_name") @db.VarChar(512)
  prefix    String?          @db.VarChar(256)
  kind      ImageVariantKind
  format    ImageFormat
  mimeType  String           @map("mime_type") @db.VarChar(64)
  width     Int?
  height    Int?
  sizeBytes BigInt?          @map("size_bytes")
  etag      String?          @db.VarChar(128)
  profile   String?          @db.VarChar(64)

  @@unique([bucket, imageName], map: "uniq_bucket_key")
  @@index([kind], map: "idx_variant_kind")
  @@index([imageUuid], map: "idx_variant_image")
  @@map("image_variants")
}

model SeoObject {
  uuid               String @id @default(uuid())
  h1                 String
  htmlTagTitle       String
  htmlTagDescription String @db.VarChar(360)
  pageUrl            String @map("page_url")
  page               Page   @relation(fields: [pageUrl], references: [url], onDelete: Cascade)
  locale             Locale

  @@unique([pageUrl, locale], map: "uniq_seo_page_locale")
  @@map("seo_objects")
}