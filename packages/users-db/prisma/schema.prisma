generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER  @map("user")
  ADMIN @map("admin")
}

enum UserGender {
  MALE   @map("male")
  FEMALE @map("female")
  OTHER  @map("other")
}

enum Locale {
  EN @map("en")
  UK @map("uk")
}

model User {
  uuid      String   @id @default(uuid())
  email     String   @unique
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url")
  role      Role     @default(USER)
  active    Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  login             String
  about             String     @db.VarChar(300)
  vip               Boolean
  vipExpirationDate DateTime   @map("vip_expiration_date") @db.Date
  gender            UserGender @default(OTHER) @map("user_gender")
  userIp            String     @map("user_ip")
  lastVisit         DateTime?  @map("last_visit")
  timezone          String     @default("Europe/Kiev")
  locale            Locale     @default(UK)
  @@map("users")
}

model AdminUser {
  uuid      String   @id @default(uuid())
  email     String   @unique
  fullName  String?  @map("full_name")
  role      Role     @default(ADMIN)
  active    Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("admins")
}