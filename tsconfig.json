{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "baseUrl": "./",
    "paths": {
      "@app/common": ["libs/common/src"],
      "@app/common/*": ["libs/common/src/*"],
      "@app/prisma-auth": ["packages/auth-db/src"],
      "@app/prisma-users": ["packages/users-db/src"],
      "@app/prisma-media": ["packages/media-db/src"],
      "@app/prisma-content": ["packages/content-db/src"],
      "@app/prisma-attention": ["packages/attention-db/src"],
      "@app/prisma-mind-track": ["packages/mind-track-db/src"]
    },
    "outDir": "./dist"
  },
  "exclude": ["node_modules", "dist"]
}
